# Copy to .env. All keys stay on the server.

# Higgs Realtime voice. Or set BOSON_API_KEY_FILE=/path/to/key instead.
BOSON_API_KEY=
# Live question updates during a call (POST /api/questions).
ANTHROPIC_API_KEY=
# Opening questions, findings and next-round planning.
OPENAI_API_KEY=
# Optional; default is the first GPT-6 model the key can use.
OPENAI_MODEL=

# Optional Higgs Avatar (LiveKit Cloud project).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# PORT=3000
# BOSON_BASE_URL=https://api.boson.ai

# Copy to .env. All keys stay on the server.

# Supabase Postgres: projects, interviews, transcripts, claims, evidence.
# Supabase dashboard -> Connect -> Session pooler URI. Run supabase/migrations first.
DATABASE_URL=

# Higgs Realtime voice. Or set BOSON_API_KEY_FILE=/path/to/key instead.
BOSON_API_KEY=
# Claude: opening questions, live question updates, findings and next-round planning.
ANTHROPIC_API_KEY=

# Optional Higgs Avatar (LiveKit Cloud project).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# PORT=3000
# BOSON_BASE_URL=https://api.boson.ai

# Deployed only: the frontend's address, so its pages may call this API.
# FRONTEND_ORIGIN=https://diligence-frontend.<subdomain>.workers.dev

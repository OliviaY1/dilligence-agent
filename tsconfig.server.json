{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "composite": true,
    "types": ["node"]
  },
  "include": [
    "server",
    "frontend/src/lib/types.ts",
    "frontend/src/lib/call-mirror.ts",
    "frontend/src/lib/mock-service.ts",
    "frontend/src/lib/mock-data.ts",
    "frontend/src/lib/validation-request.ts"
  ]
}
